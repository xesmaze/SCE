  "managers": [
    {
      "name": "Sowing",
      "code": [
        "using Models.Interfaces;",
        "using APSIM.Shared.Utilities;",
        "using Models.Utilities;",
        "using Models.Soils;",
        "using Models.PMF;",
        "using Models.Core;",
        "using System;",
        "using System.Linq;",
        "using Models.Climate;",
        "",
        "namespace Models",
        "{",
        "    [Serializable]",
        "    public class Script : Model",
        "    {",
        "        [Link] private Clock Clock;",
        "        [Link] private Fertiliser Fertiliser;",
        "        [Link] private Summary Summary;",
        "        [Link] private Soil Soil;",
        "        private Accumulator accumulatedRain;",
        "        [Link]",
        "        private ISoilWater waterBalance;",
        "",
        "        [Description(\"Crop\")]",
        "        public IPlant Crop { get; set; }",
        "",
        "\t\t[Separator(\"If Sowing Date is specified\")]",
        "\t\t[Description(\"Sowing date (d-mmm)\")]",
        "        public string SowDate { get; set; }",
        "",
        "\t\t[Separator(\"If Sowing Date is not specified\")]",
        "        [Description(\"Start of sowing window (d-mmm)\")]",
        "        public string StartDate { get; set; }",
        "",
        "        [Description(\"End of sowing window (d-mmm)\")]",
        "        public string EndDate { get; set; }",
        "",
        "        [Description(\"Minimum extractable soil water for sowing (mm)\")]",
        "        public double MinESW { get; set; }",
        "",
        "        [Description(\"Accumulated rainfall required for sowing (mm)\")]",
        "        public double MinRain { get; set; }",
        "",
        "        [Description(\"Duration of rainfall accumulation (d)\")]",
        "        public int RainDays { get; set; }",
        "        ",
        "        [Description(\"Force sowing by end of window?\")]",
        "        public bool ForceSow { get; set; }",
        "",
        "\t\t[Separator(\"Sowing Parameters\")]",
        "        [Display(Type = DisplayType.CultivarName)]",
        "        [Description(\"Cultivar to be sown\")]",
        "        public string CultivarName { get; set; }",
        "",
        "        [Description(\"Sowing depth (mm)\")]",
        "        public double SowingDepth { get; set; }",
        "",
        "        [Description(\"Row spacing (mm)\")]",
        "        public double RowSpacing { get; set; }",
        "",
        "        [Description(\"Plant population (/m2)\")]",
        "        public double Population { get; set; }",
        "",
        "        ",
        "        public string SimSowDate { get; set; }",
        "        public bool SeasonOpen { get; set; }",
        "        ",
        "        [EventSubscribe(\"StartOfSimulation\")]",
        "        private void OnSimulationCommencing(object sender, EventArgs e)",
        "        {",
        "            accumulatedRain = new Accumulator(this, \"[Weather].Rain\", RainDays);",
        "            SeasonOpen = true;",
        "        }",
        "",
        "        [EventSubscribe(\"DoManagement\")]",
        "        private void OnDoManagement(object sender, EventArgs e)",
        "        {",
        "            accumulatedRain.Update();",
        "            SimSowDate = \"NA\";",
        "            bool SowNow = false;",
        "            ",
        "            if (SeasonOpen) { // Only allow one attempt at sowing.",
        "                if (SowDate != \"NA\") {",
        "\t\t            if (DateUtilities.WithinDates(SowDate, Clock.Today, SowDate)) // Sow at date specified.",
        "\t\t            {",
        "\t\t               SowNow = true;",
        "\t\t            }",
        "                } else { ",
        "                    if (DateUtilities.WithinDates(StartDate, Clock.Today, EndDate) && // If no date specified, sow when parameters met. ",
        "\t\t                    !Crop.IsAlive &&",
        "\t\t                    MathUtilities.Sum(waterBalance.ESW) > MinESW &&",
        "\t\t                    accumulatedRain.Sum > MinRain)",
        "\t\t                {",
        "\t\t                    SowNow = true;",
        "\t\t                } ",
        "\t\t            if (ForceSow && // If it's the end of the sowing window and we haven't sown yet, sow. ",
        "\t\t                    !Crop.IsAlive &&",
        "\t\t                    DateUtilities.DatesEqual(EndDate, Clock.Today)) ",
        "\t\t                {",
        "\t\t                    SowNow = true;",
        "\t\t                }",
        "\t\t         }",
        "\t\t     }",
        "\t\t     ",
        "\t\t     if (SowNow) {",
        "\t\t        Crop.Sow(population: Population, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);    ",
        "\t\t         \t   SimSowDate = Clock.Today.ToString(\"yyyy-MM-dd\");",
        "\t\t         \t   SeasonOpen = false;",
        "\t\t     }",
        "\t\t     ",
        "        }",
        "    }",
        "}"
      ],
      "parameters": [
        {
          "Key": "Crop",
          "Value": "[Soybean]"
        },
        {
          "Key": "SowDate",
          "Value": "NA"
        },
        {
          "Key": "StartDate",
          "Value": "15-march"
        },
        {
          "Key": "EndDate",
          "Value": "31-may"
        },
        {
          "Key": "MinESW",
          "Value": "100"
        },
        {
          "Key": "MinRain",
          "Value": "25"
        },
        {
          "Key": "RainDays",
          "Value": "7"
        },
        {
          "Key": "ForceSow",
          "Value": "True"
        },
        {
          "Key": "CultivarName",
          "Value": "Generic_MG1"
        },
        {
          "Key": "SowingDepth",
          "Value": "30"
        },
        {
          "Key": "RowSpacing",
          "Value": "750"
        },
        {
          "Key": "Population",
          "Value": "6"
        }
      ]
